# Production candidate: MapTiler + MapLibre.
# Create a native/mobile API key in MapTiler and restrict it per provider guidance.
# EXPO_PUBLIC_* values are embedded in the client bundle: never use a secret/server key here.
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_MAPTILER_STYLE=streets-v4

# Optional escape hatch for another MapLibre-compatible provider or self-hosted style.
# When set, this custom style URL takes precedence over MapTiler.
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=
