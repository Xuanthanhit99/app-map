# Server-side base URL of the REALITY API (never exposed to the browser).
API_INTERNAL_URL=http://127.0.0.1:3001
# Public canonical origin of this web app (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Map style: a MapLibre style URL (e.g. MapTiler) or empty for the OpenStreetMap raster fallback
# (OSM tiles are for light/QA use only — production needs a tile provider; see docs/release).
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_TILE_HOSTS=
# Set to "true" only in production with HTTPS so session cookies are Secure.
COOKIE_SECURE=false
