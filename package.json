{
  "name": "app-map",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/mobile",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @app-map/api && npm run typecheck --workspace @app-map/mobile && npm run typecheck --workspace @app-map/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:start": "npm run start --workspace @app-map/mobile",
    "test:int": "vitest run tests/*.int.test.ts",
    "db:migrate": "npm run migrate --workspace @app-map/api",
    "api:dev": "npm run dev --workspace @app-map/api",
    "web:dev": "npm run dev --workspace @app-map/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
