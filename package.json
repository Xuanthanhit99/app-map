{
  "name": "app-map",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/mobile",
    "apps/api"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @app-map/api && npm run typecheck --workspace @app-map/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:start": "npm run start --workspace @app-map/mobile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
